# 1. DATABASE CONFIGURATION (RECOMMENDED: Neon-hosted PostgreSQL)
# Connects to your Neon serverless PostgreSQL instance with Drizzle ORM
# Format: postgresql://[user]:[password]@[endpoint-pooler].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_PXUAhEMf1id9@ep-damp-math-b5724cky-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require


# 2. ALTERNATIVE: SUPABASE POSTGRESQL & AUTH (OPTIONAL)
# If using Supabase instead of Neon, configure the credentials below:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. AUTHENTICATION & SECURITY
# Cryptographic secret used for signing secure HTTP-Only JWT session cookies
SESSION_SECRET=medrella_super_secure_healthcare_jwt_session_secret_2026_key

# 4. CLINIC AUTHORIZATION KEY (CONTROLLED DOCTOR PROVISIONING)
# Prevents public self-assignment of doctor privileges
DOCTOR_PROVISIONING_SECRET=MEDRELLA_CLINIC_ADMIN_2026

# 5. ENVIRONMENT
NODE_ENV=development
