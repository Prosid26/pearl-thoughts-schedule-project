# ========================================================================
# PEARL THOUGHTS SCHEDULE PROJECT — ENVIRONMENT CONFIGURATION
# ========================================================================

# 1. DATABASE CONFIGURATION (RECOMMENDED: Neon-hosted PostgreSQL)
# Connects to your Neon serverless PostgreSQL instance with Drizzle ORM
# Format: postgresql://[user]:[password]@[endpoint-pooler].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_PXUAhEMf1id9@ep-damp-math-b5724cky-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require


# 2. ALTERNATIVE: SUPABASE POSTGRESQL & AUTH (OPTIONAL)
# If using Supabase instead of Neon, configure the credentials below:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. AUTHENTICATION & SECURITY
# Cryptographic secret used for signing secure HTTP-Only JWT session cookies
SESSION_SECRET=medrella_super_secure_healthcare_jwt_session_secret_2026_key

# 4. CLINIC AUTHORIZATION KEY (CONTROLLED DOCTOR PROVISIONING)
# Prevents public self-assignment of doctor privileges
DOCTOR_PROVISIONING_SECRET=MEDRELLA_CLINIC_ADMIN_2026

# 5. ONLINE PAYMENTS & REFUNDS (RAZORPAY)
# Obtain these credentials from your Razorpay Dashboard (https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# 6. NOTIFICATIONS (EMAIL & SMS)
# If left unconfigured, system safely defaults to Console/Simulated delivery
EMAIL_PROVIDER_API_KEY=re_your_resend_api_key_here
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Medrella Healthcare <appointments@medrella.com>"

# SMS Notifications (Twilio)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# 7. AUTOMATED APPOINTMENT REMINDERS (CRON RUNNER)
# Bearer secret used to authorize scheduled reminder runner (GET/POST /api/reminders/process)
CRON_SECRET=medrella_secure_cron_secret_2026

# 8. CLINICAL CANCELLATION & REFUND POLICY CONFIGURATION
# Configurable cancellation windows and refund percentages
CANCELLATION_FULL_REFUND_HOURS=24
CANCELLATION_PARTIAL_REFUND_HOURS=2
CANCELLATION_PARTIAL_REFUND_PERCENT=50

# 9. WHATSAPP BUSINESS CLOUD API (META)
# Official Meta Cloud API credentials for automated healthcare messaging & reminders
# Endpoint: https://graph.facebook.com/v21.0/{WHATSAPP_PHONE_NUMBER_ID}/messages
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_cloud_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_whatsapp_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# 10. ENVIRONMENT
NODE_ENV=development

# 11. APPLICATION PUBLIC URL & WEBHOOK ENDPOINTS REFERENCE
# Used for generating signed email unsubscribe links & external provider callbacks
NEXT_PUBLIC_APP_URL=https://pearl-thoughts-schedule-project.vercel.app

# Official Webhook Endpoint URLs to register in Provider Dashboards:
# - Razorpay Webhook URL:   https://your-domain.com/api/webhooks/razorpay (Secret: RAZORPAY_WEBHOOK_SECRET)
# - WhatsApp Webhook URL:  https://your-domain.com/api/webhooks/whatsapp (Verify Token: WHATSAPP_VERIFY_TOKEN, App Secret: WHATSAPP_APP_SECRET)
# - Twilio SMS Webhook URL: https://your-domain.com/api/webhooks/twilio (Auth Token: TWILIO_AUTH_TOKEN)
# - Scheduled Cron URL:     https://your-domain.com/api/reminders/process (Authorization: Bearer CRON_SECRET)
